pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code'
            }
        }

        stage('Build') {
            steps {
                echo 'Building application'
                sh 'docker build -t cicd-project .'
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests'
            }
        }

    }
}
